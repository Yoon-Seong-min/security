{
  "name": "cosmos-lock-mvp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf apps/web/.next .next node_modules/.cache",
    "dev": "npm run clean && next dev apps/web --hostname 0.0.0.0",
    "dev:fast": "next dev apps/web --hostname 0.0.0.0",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 0.0.0.0",
    "test": "vitest run",
    "check:crypto": "grep -R --line-number -E \"cryptoObj\\.randomId|\\.randomId\\(|node:crypto|from ['\\\"]crypto['\\\"]|require\\(['\\\"]crypto['\\\"]\\)\" packages apps tests || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "next": "15.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "idb": "^8.0.2"
  }
}
